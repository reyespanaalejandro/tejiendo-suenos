---
import Base from '../layouts/Base.astro';
import { ENVIOS, NEGOCIO, PAGOS, CUIDADO } from '../lib/negocio';

const preguntas = [
  { q: '¿El precio es por persona o por el set familiar?', a: 'Es por persona. Las tallas de adulto (S a XL) valen $130.000 y las de niño (2 a 16), $95.000. Por ejemplo, la pijama familiar para mamá, papá e hijo cuesta $355.000. Las pantuflas tienen precio por par.' },
  { q: '¿De qué material son las pijamas?', a: 'De algodón colombiano con sello TEKS, hipoalergénico. No se estira ni se encoge, y la composición de la etiqueta es la real.' },
  { q: '¿Cuánto duran?', a: 'Años. Tenemos pijamas de 8 años que siguen en buen estado, y a los niños les quedan pequeñas antes de que se dañen. Por eso las costuras tienen garantía de por vida y el estampado, de dos años (no cubre daños por mal lavado).' },
  { q: '¿Tienen bolsillos?', a: 'Sí, nuestras pijamas tienen bolsillos.' },
  { q: '¿Qué diseños tienen?', a: 'Diseños propios que renovamos cada tres meses: familiares, navideños, ejecutivas, náuticas y más. También tenemos pijamas con personajes, de superhéroes y de equipos de fútbol.' },
  { q: '¿Hacen envíos?', a: `${ENVIOS.nacional} ${ENVIOS.bogota}` },
  { q: '¿Cómo pago?', a: `${PAGOS.tienda} ${PAGOS.distancia}` },
  { q: '¿Cómo lavo mi pijama para que dure más?', a: CUIDADO.join(' ') },
  { q: '¿Puedo cambiar la talla?', a: 'Sí, puedes cambiar la pijama por otra talla. Si llega con un defecto, también te la cambiamos. No hacemos devolución de dinero.' },
  { q: '¿Puedo ir a medírmela?', a: `Claro. Tenemos dos tiendas en Bogotá: ${NEGOCIO.tiendas.map((t) => `${t.centroComercial}, ${t.local}`).join(', y ')}. Ve a la que te quede más cerca.` },
  { q: '¿Hacen tallas grandes?', a: 'Sí. Si no encuentras tu talla, te hacemos la pijama a la medida.' },
  { q: '¿Venden al por mayor?', a: 'Sí, somos fábrica y surtimos tiendas en toda Colombia. Mira nuestra página de ventas al por mayor.' },
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: preguntas.map((p) => ({ '@type': 'Question', name: p.q, acceptedAnswer: { '@type': 'Answer', text: p.a } })) };
---
<Base title="Preguntas frecuentes | Tejiendo Sueños" description="Precios por persona, material, durabilidad, envíos, cambios y tallas de las pijamas Tejiendo Sueños.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <section class="pagina-cabeza">
    <div class="contenedor">
      <nav class="migas" aria-label="Ruta"><a href="/">Inicio</a> / Preguntas frecuentes</nav>
      <h1>Preguntas frecuentes</h1>
      <p>Lo que más nos preguntan antes de comprar. Si tu pregunta no está aquí, escríbenos.</p>
    </div>
  </section>
  <section class="seccion">
    <div class="contenedor preguntas">
      {preguntas.map((p, i) => <details open={i === 0}><summary>{p.q}</summary><p>{p.a}</p></details>)}
    </div>
  </section>
</Base>

<style>
  .preguntas { max-width: 820px; }
  details { border-bottom: 1px solid var(--borde); padding: 1.1rem 0; }
  summary { cursor: pointer; font-family: var(--f-titulo); font-weight: 600; font-size: 1.2rem; color: var(--ciruela); list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--magenta); font-size: 1.5rem; line-height: 1; }
  details[open] summary::after { content: '–'; }
  details p { margin: .7rem 0 0; color: var(--texto-suave); }
</style>
