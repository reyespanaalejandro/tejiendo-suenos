---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Sellos from '../components/Sellos.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import { LINEAS, PRODUCTOS, foto, pesos } from '../lib/catalogo';
import { NEGOCIO, whatsappUrl, MENSAJE_GENERAL } from '../lib/negocio';

const destacados = PRODUCTOS.filter((p) => p.destacado).slice(0, 8);
---
<Base
  title="Pijamas familiares de algodón hechas en Bogotá | Tejiendo Sueños"
  description="Fábrica colombiana de pijamas familiares, de pareja, dama, caballero y niños. Algodón certificado TEKS, tintas sin plomo y diseños propios. Envíos a toda Colombia."
>
  <section class="hero">
    <div class="contenedor hero-grid">
      <div>
        <span class="antetitulo">Fábrica colombiana · Desde {NEGOCIO.fabricaDesde}</span>
        <h1>Pijamas para toda la familia, hechas con amor en Bogotá</h1>
        <p class="hero-sub">Algodón que se siente suave desde la primera noche y diseños tiernos que van iguales para papá, mamá, los niños y la foto familiar.</p>
        <div class="hero-ctas">
          <a class="boton boton-primario" href="/pijamas-familiares">Ver pijamas familiares</a>
          <a class="boton boton-borde" href="/tienda">Ver toda la tienda</a>
        </div>
      </div>
      <div class="hero-foto">
        <Picture src={foto('familia-tortugas')} formats={['avif']} fallbackFormat="webp" widths={[640, 960, 1400]} sizes="(min-width: 960px) 580px, 100vw" alt="Familia de seis con pijamas iguales verde menta estampadas con tortugas" loading="eager" fetchpriority="high" />
      </div>
    </div>
    <div class="contenedor hero-sellos"><Sellos /></div>
  </section>

  <section class="seccion" id="lineas">
    <div class="contenedor">
      <span class="antetitulo">Nuestras líneas</span>
      <h2>¿Para quién es la pijama?</h2>
      <div class="lineas">
        {LINEAS.map((l, i) => (
          <a class="linea" href={`/${l.slug}`}>
            <Picture src={foto(l.portada)} formats={['avif']} fallbackFormat="webp" widths={[320, 520]} sizes="(min-width: 960px) 270px, 46vw" alt="" loading={i < 4 ? 'eager' : 'lazy'} />
            <span>{l.nombre}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion destacados">
    <div class="contenedor">
      <div class="cabeza-seccion">
        <div>
          <span class="antetitulo">Las más pedidas</span>
          <h2>Pijamas que ya están en muchas fotos familiares</h2>
        </div>
        <a class="ver-todo" href="/tienda">Ver todas →</a>
      </div>
      <div class="rejilla">
        {destacados.map((p) => <TarjetaProducto p={p} />)}
      </div>
    </div>
  </section>

  <section class="seccion durabilidad">
    <div class="contenedor dura-grid">
      <div>
        <span class="antetitulo">Calidad que dura</span>
        <h2>Una pijama que dura años termina costando menos</h2>
        <p>Una pijama barata que se daña en un año te toca volverla a comprar cada año. Las nuestras están hechas con algodón certificado, costuras de seguridad y estampados que no se caen: a los niños les quedan pequeñas antes de que se dañen.</p>
        <p class="dura-cita">La primera pijama de Navidad que hicimos, nuestro hijo la sigue usando.</p>
      </div>
      <div class="cuenta" aria-label="Ejemplo de costo por año">
        <div class="cuenta-fila"><span>Pijama de adulto</span><strong>{pesos(130000)}</strong></div>
        <div class="cuenta-fila"><span>Años de uso</span><strong>÷ 5</strong></div>
        <div class="cuenta-total"><span>Te cuesta al año</span><strong>{pesos(26000)}</strong></div>
        <p class="cuenta-nota">Con buen cuidado duran mucho más: tenemos pijamas de 8 años en buen estado.</p>
      </div>
    </div>
  </section>

  <section class="seccion navidad">
    <div class="contenedor nav-grid">
      <div class="nav-foto">
        <Picture src={foto('familia-navidad-renos')} formats={['avif']} fallbackFormat="webp" widths={[640, 1000, 1400]} sizes="(min-width: 960px) 600px, 100vw" alt="Familia sentada con pijamas navideñas beige y pantalón de cuadros rojos" />
      </div>
      <div>
        <span class="antetitulo">Temporada de Navidad</span>
        <h2>Este diciembre, todos iguales</h2>
        <p>Pijamas navideñas para las velitas, la novena y la foto familiar. Tallas de la 2 a la XL, al mismo precio por persona.</p>
        <a class="boton boton-primario" href="/pijamas-navidenas">Ver pijamas navideñas</a>
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor dos-tarjetas">
      <a class="tarjeta-grande personalizadas" href="/pijamas-personalizadas">
        <span class="antetitulo">A tu medida</span>
        <h2>Pijamas personalizadas</h2>
        <p>Con nombres, iniciales o para un evento: pijamadas, cumpleaños, despedidas. También hacemos tallas grandes a la medida.</p>
        <span class="enlace">Ver cómo funciona →</span>
      </a>
      <a class="tarjeta-grande mayor" href="/pijamas-al-por-mayor">
        <span class="antetitulo">Para tu negocio</span>
        <h2>Ventas al por mayor</h2>
        <p>¿Tienes una tienda? Te surtimos directo de nuestra fábrica en Bogotá, con despachos a toda Colombia.</p>
        <span class="enlace">Conoce el por mayor →</span>
      </a>
    </div>
  </section>

  <section class="seccion historia">
    <div class="contenedor historia-grid">
      <div>
        <span class="antetitulo">Quiénes somos</span>
        <h2>Detrás de cada pijama hay una familia</h2>
        <p>Tejiendo Sueños empezó en {NEGOCIO.fabricaDesde} en el apartamento de una familia bogotana que quería salir adelante. Hoy es una fábrica donde madres cabeza de familia cosen cada pijama y donde los hilos sueltos se cortan a mano, uno por uno.</p>
        <a class="boton boton-claro" href="/nosotros">Conoce nuestra historia</a>
      </div>
      <div class="historia-foto">
        <Picture src={foto('familia-gorilas')} formats={['avif']} fallbackFormat="webp" widths={[480, 800]} sizes="(min-width: 960px) 420px, 90vw" alt="Familia con pijamas iguales color arena estampadas con gorilas" />
      </div>
    </div>
  </section>

  <section class="seccion visita">
    <div class="contenedor visita-in">
      <div>
        <h2>Ven a tocarlas</h2>
        <p>La mejor forma de entender la diferencia es sentir la tela. Te esperamos en el {NEGOCIO.tienda.centroComercial}, {NEGOCIO.tienda.local}.</p>
        <p class="visita-horario">{NEGOCIO.horario.map((h) => `${h.dias}: ${h.horas}`).join(' · ')}</p>
      </div>
      <div class="visita-ctas">
        <a class="boton boton-primario" href={NEGOCIO.tienda.mapsUrl} target="_blank" rel="noopener">Cómo llegar</a>
        <a class="boton boton-wa" href={whatsappUrl(MENSAJE_GENERAL)} data-wa="inicio-visita" target="_blank" rel="noopener">Escríbenos</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { background: radial-gradient(1100px 480px at 85% 0%, var(--lila-2), transparent 60%), var(--lila); padding: clamp(32px, 6vw, 72px) 0 clamp(32px, 5vw, 56px); }
  .hero-grid { display: grid; gap: 2rem; align-items: center; }
  .hero-sub { font-size: 1.2rem; color: var(--texto-suave); max-width: 540px; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }
  .hero-foto :global(img) { border-radius: 28px 28px 120px 28px; box-shadow: var(--sombra); width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .hero-sellos { margin-top: clamp(28px, 5vw, 48px); }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: 1fr 1.1fr; } }

  .lineas { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2rem; }
  .linea { position: relative; display: block; border-radius: 22px; overflow: hidden; aspect-ratio: 1 / 1; text-decoration: none; background: var(--lila); }
  .linea :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; transition: transform .4s ease; }
  .linea:hover :global(img) { transform: scale(1.04); }
  .linea span { position: absolute; left: 0; right: 0; bottom: 0; padding: 2.4rem 1rem .9rem; color: #fff; font-family: var(--f-titulo); font-weight: 800; font-size: 1.35rem; background: linear-gradient(transparent, rgba(59, 24, 56, .85)); }
  @media (min-width: 900px) { .lineas { grid-template-columns: repeat(4, 1fr); } }

  .destacados { background: #fff; }
  .cabeza-seccion { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; }
  .ver-todo { font-weight: 700; text-decoration: none; margin-bottom: 1rem; }
  .rejilla { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.6rem 1rem; margin-top: 1.6rem; }
  @media (min-width: 900px) { .rejilla { grid-template-columns: repeat(4, 1fr); } }

  .dura-grid { display: grid; gap: 2rem; align-items: center; }
  .dura-cita { font-family: var(--f-titulo); font-size: 1.3rem; color: var(--magenta); line-height: 1.3; margin-top: 1.4rem; }
  .cuenta { background: #fff; border-radius: var(--radio); border: 1px solid var(--borde); padding: 1.6rem; box-shadow: var(--sombra); font-variant-numeric: tabular-nums; }
  .cuenta-fila, .cuenta-total { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-bottom: 1px dashed var(--borde); font-size: 1.1rem; }
  .cuenta-fila strong { font-family: var(--f-titulo); font-size: 1.4rem; color: var(--ciruela); }
  .cuenta-total { border-bottom: 0; align-items: baseline; }
  .cuenta-total span { font-weight: 700; }
  .cuenta-total strong { font-family: var(--f-titulo); font-size: 2.4rem; color: var(--magenta); }
  .cuenta-nota { margin: .6rem 0 0; font-size: .92rem; color: var(--texto-suave); }
  @media (min-width: 900px) { .dura-grid { grid-template-columns: 1.2fr 1fr; gap: 4rem; } }

  .navidad { background: linear-gradient(160deg, #fbeff6, var(--lila)); }
  .nav-grid { display: grid; gap: 2rem; align-items: center; }
  .nav-foto :global(img) { border-radius: 120px 28px 28px 28px; width: 100%; }
  @media (min-width: 900px) { .nav-grid { grid-template-columns: 1.2fr 1fr; gap: 3rem; } }

  .dos-tarjetas { display: grid; gap: 1.2rem; }
  .tarjeta-grande { display: block; padding: 2rem; border-radius: var(--radio); text-decoration: none; color: var(--texto); border: 1px solid var(--borde); transition: transform .15s ease; }
  .tarjeta-grande:hover { transform: translateY(-2px); }
  .tarjeta-grande p { color: var(--texto-suave); }
  .tarjeta-grande .enlace { font-weight: 700; color: var(--magenta); }
  .personalizadas { background: #fff; }
  .mayor { background: var(--lila); }
  @media (min-width: 800px) { .dos-tarjetas { grid-template-columns: 1fr 1fr; } }

  .historia { background: var(--ciruela); color: #f5ecf4; }
  .historia h2 { color: #fff; }
  .historia .antetitulo { color: #f1a7d9; }
  .historia-grid { display: grid; gap: 2rem; align-items: center; }
  .historia-foto :global(img) { border-radius: 28px 120px 28px 28px; width: 100%; max-height: 520px; object-fit: cover; }
  @media (min-width: 900px) { .historia-grid { grid-template-columns: 1.2fr 1fr; gap: 4rem; } }

  .visita { padding-block: clamp(40px, 6vw, 64px); }
  .visita-in { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; background: #fff; border: 1px solid var(--borde); border-radius: var(--radio); padding: 2rem; }
  .visita-in > div:first-child { flex: 1 1 420px; min-width: 0; }
  .visita-in p { color: var(--texto-suave); margin: 0 0 .5rem; }
  .visita-horario { font-size: .95rem; }
  .visita-ctas { display: flex; flex-wrap: wrap; gap: .7rem; }
</style>
