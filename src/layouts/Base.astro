---
import '@fontsource/baloo-2/600.css';
import '@fontsource/baloo-2/800.css';
import '@fontsource/nunito-sans/400.css';
import '@fontsource/nunito-sans/700.css';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { whatsappUrl, MENSAJE_GENERAL } from '../lib/negocio';
import { grafoNegocio } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
  mensajeWa?: string;
  // Datos estructurados propios de la página (producto, migas, preguntas…).
  // El negocio y las dos tiendas se agregan siempre.
  ld?: Record<string, unknown>[];
}
const { title, description, image, mensajeWa = MENSAJE_GENERAL, ld = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const grafo = { '@context': 'https://schema.org', '@graph': [...(await grafoNegocio()), ...ld] };
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="theme-color" content="#a3197c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/markdown" title="Resumen para asistentes de IA" href="/llms.txt" />
    <script type="application/ld+json" set:html={JSON.stringify(grafo)} />
    <slot name="head" />
    <!-- Etiqueta de Google (Google Ads AW-18592378672) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18592378672"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18592378672');
    </script>
  </head>
  <body>
    <Cabecera />
    <main>
      <slot />
    </main>
    <Pie />

    <a class="wa-flotante" href={whatsappUrl(mensajeWa)} data-wa="flotante" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.3z"/></svg>
    </a>

    <script>
      // Medición de conversiones de Google Ads:
      // - "Clic en WhatsApp": cualquier enlace con data-wa o que vaya a wa.me
      // - "Clic en Cómo llegar": cualquier enlace a Google Maps
      const CONV_WHATSAPP = 'AW-18592378672/DCghCO3woL4dELDexKFF';
      const CONV_COMO_LLEGAR = 'AW-18592378672/kf3gCL68pr4dELDexKFF';
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
        if (!a) return;
        const w = window as unknown as { gtag?: (...x: unknown[]) => void };
        if (a.dataset.wa !== undefined || a.href.includes('wa.me/')) {
          if (a.getAttribute('aria-disabled') === 'true') return;
          w.gtag?.('event', 'conversion', { send_to: CONV_WHATSAPP });
          w.gtag?.('event', 'contacto_whatsapp', { origen: a.dataset.wa || 'enlace', pagina: location.pathname });
        } else if (/google\.[a-z.]+\/maps|maps\.app\.goo\.gl|goo\.gl\/maps/.test(a.href)) {
          w.gtag?.('event', 'conversion', { send_to: CONV_COMO_LLEGAR });
          w.gtag?.('event', 'como_llegar', { pagina: location.pathname });
        }
      });
    </script>
  </body>
</html>

<style>
  .wa-flotante { position: fixed; right: 16px; bottom: 16px; z-index: 30; width: 60px; height: 60px; border-radius: 50%; display: grid; place-items: center; background: var(--verde-wa); color: #fff; box-shadow: 0 12px 28px -10px rgba(0, 0, 0, .45); }
  .wa-flotante svg { width: 32px; height: 32px; }
</style>
